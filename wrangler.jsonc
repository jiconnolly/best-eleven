{
  // Static-assets-only Worker: no server code, Cloudflare serves the files directly.
  // Without this file `wrangler deploy` / `wrangler versions upload` fails with
  // "Missing entry-point to Worker script or to assets directory".
  "name": "best-eleven-website",
  "compatibility_date": "2026-08-02",
  "assets": {
    "directory": "./"
  }
}
